# API keys
COINGECKO_API_KEY=YOUR_KEY_HERE            # required for production fetches (leave blank for local dev)

# Postgres (used by pipeline, dashboard, tests)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crypto_db
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto

# Optional test DB (used by CI integration tests)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/testdb

# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ   # optional - leave blank to disable Slack

# Runtime tuning
COINGECKO_REQUEST_TIMEOUT=30
COINGECKO_REQUEST_RETRIES=3
COINGECKO_BACKOFF_BASE=2              # seconds (exponential backoff base)
RATE_LIMIT_SLEEP_TIME=1.5

# Backfill / behavior
BACKFILL_DAYS=90

# Logging / observability
LOG_LEVEL=INFO

# Optional: set a RUN_ID for reproducible runs (auto-generated if empty)
RUN_ID=